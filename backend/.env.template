# Environment variables for Curate backend
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (required for LLM and embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone API Key (required for RAG functionality)
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone Knowledge Index Name
PINECONE_KNOWLEDGE_INDEX_NAME=curate-knowledge

# AWS credentials (optional, for SageMaker integration)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1
